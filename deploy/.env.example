# =============================================================
# VOCIRA production environment - TEMPLATE
#
# This file stays in git and must hold NO real secret. The real
# values go into `deploy/.env.prod`, which is gitignored.
#
# How to build it:
#
#     python deploy/gen-secrets.py
#
# That script generates strong secrets on its own and carries API
# keys over from your existing .env files.
# =============================================================


# -------------------------------------------------------------
# DOMAIN - point these four subdomains at this VM's public IP
#
#     api.<domain>   the frontend's API calls
#     rt.<domain>    the admin's incoming-call ring (WebSocket)
#     lk.<domain>    LiveKit signalling
#     erp.<domain>   ERPNext
#
# With a real domain, DOMAIN below is all you need - the four
# subdomains are built from it automatically.
#
# On a free service like DuckDNS there is no wildcard: each name
# (yourname.duckdns.org) is one flat registration. There you need
# four separate registrations (api-yourname.duckdns.org, and so
# on) and must set API_DOMAIN / RT_DOMAIN / LK_DOMAIN / ERP_DOMAIN
# below explicitly - DOMAIN itself is then unused. See
# deploy/README.md for the full walkthrough.
# -------------------------------------------------------------
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Only needed for DuckDNS (or any setup without a shared suffix).
# Leave commented out when DOMAIN above covers all four.
# API_DOMAIN=api-yourname.duckdns.org
# RT_DOMAIN=rt-yourname.duckdns.org
# LK_DOMAIN=lk-yourname.duckdns.org
# ERP_DOMAIN=erp-yourname.duckdns.org


# -------------------------------------------------------------
# The frontend's address (Vercel)
#
# The gateway lets only this origin in. Left empty it becomes "*" -
# meaning any website. Several can be given, separated by commas.
# -------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app


# -------------------------------------------------------------
# Database  (stays inside the container, closed to the outside)
# -------------------------------------------------------------
POSTGRES_USER=vocira
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vocira


# -------------------------------------------------------------
# RabbitMQ
#
# guest/guest does not work here - RabbitMQ only accepts 'guest'
# from localhost, not from another container.
# -------------------------------------------------------------
RABBITMQ_USER=vocira
RABBITMQ_PASSWORD=CHANGE_ME


# -------------------------------------------------------------
# Auth
#
# JWT_SECRET_KEY needs to be at least 32 bytes. A short secret is
# dangerous on the internet: it can be guessed, and a guessed
# secret can mint an admin token.
# -------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2
INTERNAL_SERVICE_KEY=CHANGE_ME


# -------------------------------------------------------------
# LiveKit
#
# Locally these were devkey/secret (--dev mode). Everyone knows
# those - the server needs its own keys.
# -------------------------------------------------------------
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME


# -------------------------------------------------------------
# ERPNext
#
# Running on the same VM, hence the internal address. It does not
# need to go through Caddy - that route is for the browser only.
# -------------------------------------------------------------
ERP_BASE_URL=http://erpnext:8080
ERP_API_KEY=CHANGE_ME
ERP_API_SECRET=CHANGE_ME


# -------------------------------------------------------------
# LLM / STT / RAG  (copy these from your existing .env)
# -------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME
HF_TOKEN=CHANGE_ME
PINECONE_API_KEY=CHANGE_ME

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=CHANGE_ME
LLM_FAST_MODEL=qwen/qwen3.8-27b
LLM_SMART_MODEL=openai/gpt-oss-120b

EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768


# -------------------------------------------------------------
# Call limits
#
# Sized for the free VM's 4 cores. Each call runs its own agent
# and its own STT/TTS work, so do not raise these carelessly.
# -------------------------------------------------------------
MAX_CONCURRENT_CALLS=3
MAX_CALL_SECONDS=1800
HANDOFF_ANSWER_TIMEOUT_SECONDS=60
