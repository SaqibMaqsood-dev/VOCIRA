# =============================================================
# VOCIRA production environment - TEMPLATE
#
# Ye file git mein rehti hai aur is mein koi asli secret NAHI
# hona chahiye. Asli values `deploy/.env.prod` mein jati hain,
# jo .gitignore mein hai.
#
# Banane ka tareeqa:
#
#     python deploy/gen-secrets.py
#
# Wo script khud mazboot secrets bana deti hai aur aap ki
# maujooda .env files se API keys utha leti hai.
# =============================================================


# -------------------------------------------------------------
# DOMAIN - ye char subdomain is VM ke public IP par point karein
#
#     api.<domain>   frontend ki API calls
#     rt.<domain>    admin ki incoming-call ring (WebSocket)
#     lk.<domain>    LiveKit signalling
#     erp.<domain>   ERPNext
#
# DuckDNS jaise free service par ye "vocira.duckdns.org" ho sakta
# hai. Us soorat mein wildcard nahi milta, is liye chaar alag
# subdomain banane parenge (api-vocira.duckdns.org waghera) - ya
# apna sasta domain le lein jahan wildcard aasan hai.
# -------------------------------------------------------------
DOMAIN=example.com
ACME_EMAIL=you@example.com


# -------------------------------------------------------------
# Frontend ka pata (Vercel)
#
# Gateway sirf isi origin ko andar aane deta hai. Khali chhorne
# par "*" ho jata hai - yaani koi bhi website. Comma se ek se
# zyada bhi de sakte hain.
# -------------------------------------------------------------
CORS_ORIGINS=https://your-app.vercel.app


# -------------------------------------------------------------
# Database  (ye container ke andar hi rehta hai, bahar se band)
# -------------------------------------------------------------
POSTGRES_USER=vocira
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vocira


# -------------------------------------------------------------
# RabbitMQ
#
# guest/guest yahan chalta hi nahi - RabbitMQ 'guest' ko sirf
# localhost se aane deta hai, doosre container se nahi.
# -------------------------------------------------------------
RABBITMQ_USER=vocira
RABBITMQ_PASSWORD=CHANGE_ME


# -------------------------------------------------------------
# Auth
#
# JWT_SECRET_KEY kam az kam 32 bytes ka hona chahiye. Chhota
# secret internet par khatarnaak hai: koi usay guess kar ke apna
# admin token bana sakta hai.
# -------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2
INTERNAL_SERVICE_KEY=CHANGE_ME


# -------------------------------------------------------------
# LiveKit
#
# Local par ye devkey/secret thay (--dev mode). Wo har kisi ko
# maloom hain - server par apni keys lazmi hain.
# -------------------------------------------------------------
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME


# -------------------------------------------------------------
# ERPNext
#
# Usi VM par chal raha hai, is liye androoni pata. Caddy ke
# raaste jane ki zaroorat nahi - wo sirf browser ke liye hai.
# -------------------------------------------------------------
ERP_BASE_URL=http://erpnext:8080
ERP_API_KEY=CHANGE_ME
ERP_API_SECRET=CHANGE_ME


# -------------------------------------------------------------
# LLM / STT / RAG  (apni maujooda .env se copy karein)
# -------------------------------------------------------------
GROQ_API_KEY=CHANGE_ME
HF_TOKEN=CHANGE_ME
PINECONE_API_KEY=CHANGE_ME

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=CHANGE_ME
LLM_FAST_MODEL=qwen/qwen3.8-27b
LLM_SMART_MODEL=openai/gpt-oss-120b

EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768


# -------------------------------------------------------------
# Call ka intezaam
#
# Free VM ke 4 cores ke hisaab se. Har call ka apna agent,
# apna STT/TTS ka kaam - is liye zyada mat barhaiye.
# -------------------------------------------------------------
MAX_CONCURRENT_CALLS=3
MAX_CALL_SECONDS=1800
HANDOFF_ANSWER_TIMEOUT_SECONDS=60
