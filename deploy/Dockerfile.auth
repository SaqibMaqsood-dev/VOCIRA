# =============================================================
# VOCIRA auth service
#
# A separate image because its dependencies are very light - no
# librosa, no torch, no ffmpeg. Folding it into the heavy backend
# image would gain nothing and only make that image larger.
# =============================================================

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# argon2 / bcrypt sometimes build from source on ARM when no
# prebuilt wheel exists - a compiler is needed then
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 vocira \
    && mkdir -p /app \
    && chown vocira:vocira /app

WORKDIR /app
USER vocira

COPY --chown=vocira:vocira \
     backend/microservices/auth_services/pyproject.toml \
     backend/microservices/auth_services/uv.lock \
     /app/

RUN uv sync --frozen --no-dev --no-install-project

ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv"

COPY --chown=vocira:vocira backend /app/backend

# For creating the first admin - run once after deploying:
#   docker compose ... exec auth python create_admin.py
COPY --chown=vocira:vocira create_admin.py /app/create_admin.py

CMD ["uvicorn", "backend.microservices.auth_services.main.main:app", \
     "--host", "0.0.0.0", "--port", "8000"]
